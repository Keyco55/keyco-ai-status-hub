#!/usr/bin/env python3
"""Local CodexBar-backed quota cache and terminal status formatter.

The collector talks only to the loopback CodexBar server.  It deliberately
keeps only the small, display-safe quota subset in the cache: no account
identity, cookies, tokens, API keys, headers, or raw provider responses.
"""

from __future__ import annotations

import argparse
import datetime as dt
import fcntl
import json
import os
import pathlib
import re
import sys
import tempfile
import time
import urllib.error
import urllib.request
from typing import Any


HOME = pathlib.Path(os.environ.get("HOME") or pathlib.Path.home())
CACHE_DIR = HOME / ".cache" / "ai-resource-hud"
CACHE_FILE = CACHE_DIR / "status.json"
AGY_STATUS_FILE = CACHE_DIR / "antigravity-statusline.json"
HEALTH_FILE = CACHE_DIR / "health.json"
LOCK_FILE = CACHE_DIR / ".collector.lock"
SERVER_URL = "http://127.0.0.1:8097/usage?provider=all"
PROVIDER_IDS = ("codex", "antigravity", "alibabatokenplan")
RUNTIME_VERSION = os.environ.get("AI_RESOURCE_HUD_RUNTIME_VERSION", "unknown")
# Per-attempt ceiling for a single CodexBar request. The retry loop below
# never multiplies this: every attempt is bounded by the remaining total
# budget instead, so one scheduling interval is never exceeded.
REQUEST_TIMEOUT = 30
AGY_STATUS_MAX_AGE_SECONDS = 6 * 60 * 60
# CodexBar fetch policy: at most 2 attempts total (initial + one bounded
# retry) inside one monotonic total budget. Never a long loop; a failed
# upstream must not hang the collector nor erase a fresh statusLine fallback.
FETCH_ATTEMPTS = 2
RETRY_DELAY_SECONDS = 0.5
FETCH_BUDGET_SECONDS = 15.0
# Minimum meaningful per-attempt request timeout. When the remaining budget
# drops at or below this threshold no further request is started at all, so
# no request call is ever configured beyond the remaining deadline.
MIN_REQUEST_TIMEOUT = 0.5
HEALTH_SCHEMA_VERSION = 1
# Only sanitized operational states may appear in health output. Never raw
# bodies, identity, tokens, or paths.
ALLOWED_ERROR_CLASSES = (
    "transport_error",
    "invalid_json",
    "provider_offline",
    "statusline_stale",
    "statusline_missing",
    "statusline_malformed",
)


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def clean_source(value: Any) -> str:
    if not isinstance(value, str):
        return "unknown"
    value = value.strip()
    if 0 < len(value) <= 40 and re.fullmatch(r"[A-Za-z0-9_.-]+", value):
        return value
    return "unknown"


def clean_reset(value: Any) -> str | None:
    if isinstance(value, (int, float)) and not isinstance(value, bool):
        if value > 1_000_000_000:
            try:
                return dt.datetime.fromtimestamp(value, tz=dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
            except (OverflowError, OSError, ValueError):
                return None
        return None
    if not isinstance(value, str):
        return None
    value = value.strip()
    if not value or len(value) > 128 or "@" in value or "\n" in value or "\r" in value:
        return None
    try:
        parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
        if parsed.tzinfo is None:
            parsed = parsed.replace(tzinfo=dt.timezone.utc)
        return parsed.astimezone(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
    except ValueError:
        pass
    lower = value.lower()
    if re.search(r"\d", value) and re.search(r"(?:sec|min|hour|day|week|[smhdw])", lower):
        return value
    return None


def number(value: Any) -> float | None:
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        return float(value)
    return None


def metric_from_window(value: Any) -> dict[str, Any] | None:
    if not isinstance(value, dict):
        return None
    candidate = value
    if isinstance(value.get("window"), dict):
        candidate = value["window"]

    remaining: float | None = None
    for key in ("remainingPercent", "remaining_percentage", "percentRemaining"):
        raw = number(candidate.get(key))
        if raw is not None:
            remaining = raw
            break
    if remaining is None:
        used_percent = number(candidate.get("usedPercent"))
        if used_percent is not None:
            remaining = 100.0 - used_percent
    if remaining is None:
        used = number(candidate.get("used"))
        total = number(candidate.get("total"))
        if used is not None and total is not None and total > 0:
            remaining = 100.0 * (1.0 - used / total)
    if remaining is None:
        left = number(candidate.get("remaining"))
        total = number(candidate.get("limit")) or number(candidate.get("total"))
        if left is not None and total is not None and total > 0:
            remaining = 100.0 * left / total
    if remaining is None:
        return None

    remaining = max(0.0, min(100.0, remaining))
    result: dict[str, Any] = {"remainingPercent": round(remaining, 2)}
    for key in ("resetsAt", "resetAt", "resetTimestamp", "resetTime", "resetDescription"):
        reset = clean_reset(candidate.get(key))
        if reset is not None:
            result["resetAt"] = reset
            break
    return result


def metric_from_agy_quota(value: Any) -> dict[str, Any] | None:
    if not isinstance(value, dict):
        return None
    fraction = number(value.get("remaining_fraction"))
    if fraction is None:
        return None
    result: dict[str, Any] = {
        "remainingPercent": round(max(0.0, min(1.0, fraction)) * 100.0, 2)
    }
    reset = clean_reset(value.get("reset_time"))
    if reset is not None:
        result["resetAt"] = reset
    return result


def agy_statusline_record(payload: Any) -> dict[str, Any] | None:
    if not isinstance(payload, dict) or payload.get("product") != "antigravity":
        return None
    quota = payload.get("quota")
    if not isinstance(quota, dict):
        return None

    metrics: dict[str, Any] = {}
    for bucket, value in quota.items():
        if not isinstance(bucket, str) or not isinstance(value, dict):
            continue
        metric = metric_from_agy_quota(value)
        if metric is None:
            continue
        label = bucket.lower()
        reset_seconds = number(value.get("reset_in_seconds"))
        is_weekly = "week" in label or (reset_seconds is not None and reset_seconds > 6 * 60 * 60)
        if "gemini" in label:
            metrics["geminiWeekly" if is_weekly else "geminiFiveHour"] = metric
        elif any(token in label for token in ("claude", "gpt", "chat", "3p", "third")):
            metrics["claudeGptWeekly" if is_weekly else "claudeGptFiveHour"] = metric

    if not metrics:
        return None
    return {
        "status": "ready",
        "source": "statusline",
        "lastSuccessAt": utc_now(),
        "metrics": metrics,
    }


def label_text(key: str, value: Any) -> str:
    parts = [key]
    if isinstance(value, dict):
        for field in ("id", "title", "label", "name", "model", "kind", "type", "description"):
            raw = value.get(field)
            if isinstance(raw, str):
                parts.append(raw)
    return " ".join(parts).lower()


def windows(usage: dict[str, Any]) -> list[tuple[str, Any]]:
    result: list[tuple[str, Any]] = []
    for key in ("primary", "secondary", "tertiary", "weekly", "sevenDay", "seven_day"):
        if key in usage:
            result.append((key, usage[key]))
    extra = usage.get("extraRateWindows")
    if isinstance(extra, list):
        result.extend(("extra", item) for item in extra)
    return result


def record_base(raw: dict[str, Any]) -> dict[str, Any]:
    return {"status": "unavailable", "source": clean_source(raw.get("source"))}


def provider_record(provider: str, raw: dict[str, Any] | None) -> dict[str, Any]:
    if not isinstance(raw, dict):
        return {"status": "unavailable", "source": "loopback"}
    record = record_base(raw)
    usage = raw.get("usage")
    if raw.get("error") is not None or not isinstance(usage, dict):
        return record

    if provider == "codex":
        primary = metric_from_window(usage.get("primary"))
        weekly = metric_from_window(usage.get("secondary"))
        if primary is None or weekly is None:
            for key, value in windows(usage):
                metric = metric_from_window(value)
                if metric is None:
                    continue
                minutes = number(value.get("windowMinutes")) if isinstance(value, dict) else None
                if primary is None and (minutes == 300 or key == "primary"):
                    primary = metric
                elif weekly is None and (minutes == 10080 or key == "secondary"):
                    weekly = metric
        record["metrics"] = {"fiveHour": primary, "weekly": weekly}
    elif provider == "antigravity":
        gemini = None
        claude_gpt = None
        for key, value in windows(usage):
            metric = metric_from_window(value)
            if metric is None:
                continue
            label = label_text(key, value)
            if gemini is None and "gemini" in label:
                gemini = metric
            elif claude_gpt is None and ("claude" in label or "gpt" in label or "chat" in label):
                claude_gpt = metric
        for key, field in (("gemini", "geminiFiveHour"), ("geminiFiveHour", "geminiFiveHour"), ("claudeGpt", "claudeGptFiveHour"), ("claudeGptFiveHour", "claudeGptFiveHour")):
            metric = metric_from_window(usage.get(key))
            if metric is not None and field == "geminiFiveHour" and gemini is None:
                gemini = metric
            if metric is not None and field == "claudeGptFiveHour" and claude_gpt is None:
                claude_gpt = metric
        gemini_weekly = None
        claude_gpt_weekly = None

        extra = usage.get("extraRateWindows")
        if isinstance(extra, list):
            for item in extra:
                if not isinstance(item, dict):
                    continue

                window = item.get("window")
                if not isinstance(window, dict):
                    continue

                metric = metric_from_window(window)
                if metric is None:
                    continue

                minutes = number(window.get("windowMinutes"))
                identity = f"{item.get('id', '')} {item.get('title', '')}".lower()

                if minutes == 10080:
                    if "gemini" in identity:
                        gemini_weekly = metric
                    elif "claude" in identity or "gpt" in identity or "3p" in identity:
                        claude_gpt_weekly = metric

        record["metrics"] = {
            "geminiFiveHour": gemini,
            "geminiWeekly": gemini_weekly,
            "claudeGptFiveHour": claude_gpt,
            "claudeGptWeekly": claude_gpt_weekly,
        }
    else:
        weekly = None
        for key, value in windows(usage):
            metric = metric_from_window(value)
            if metric is None:
                continue
            label = label_text(key, value)
            minutes = number(value.get("windowMinutes")) if isinstance(value, dict) else None
            if minutes == 10080 or any(token in label for token in ("weekly", "7-day", "seven-day", "seven_day")):
                weekly = metric
                break
        if weekly is None:
            weekly = metric_from_window(usage)
        record["metrics"] = {"sevenDay": weekly}

    metrics = record.get("metrics", {})
    if isinstance(metrics, dict) and any(isinstance(value, dict) for value in metrics.values()):
        record["status"] = "ready"
        record["lastSuccessAt"] = utc_now()
    return record


def provider_key(value: Any) -> str:
    if value == "alibaba-token-plan":
        return "alibabatokenplan"
    return value if isinstance(value, str) else ""


def find_raw(payload: Any, provider: str) -> dict[str, Any] | None:
    if not isinstance(payload, list):
        return None
    for item in payload:
        if isinstance(item, dict) and provider_key(item.get("provider")) == provider:
            return item
    return None


def load_cache() -> dict[str, Any]:
    try:
        with CACHE_FILE.open("r", encoding="utf-8") as handle:
            value = json.load(handle)
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError, TypeError):
        return {}


def agy_cache_state() -> str:
    """Classify the sanitized statusLine cache: fresh, stale, missing, or malformed.

    "fresh" means a usable fallback can actually be produced (the whitelist
    reconstruction succeeds); a present-but-unusable file is "malformed".
    Only sanitized state labels are returned; file contents never leave this
    function except through load_agy_statusline on the fresh path.
    """
    try:
        age = dt.datetime.now(dt.timezone.utc).timestamp() - AGY_STATUS_FILE.stat().st_mtime
    except OSError:
        return "missing"
    if age < 0 or age > AGY_STATUS_MAX_AGE_SECONDS:
        return "stale"
    try:
        with AGY_STATUS_FILE.open("r", encoding="utf-8") as handle:
            value = json.load(handle)
    except (OSError, ValueError, TypeError):
        return "malformed"
    return "fresh" if sanitize_agy_record(value) is not None else "malformed"


# Status Hub fallback fields a sanitized statusLine cache record may carry.
# The loader reconstructs records from this whitelist only, so a manually
# modified or legacy cache can never smuggle identity or unknown fields
# into status.json. Names match the actual snapshot schema.
AGY_FALLBACK_METRIC_KEYS = ("geminiFiveHour", "geminiWeekly", "claudeGptFiveHour", "claudeGptWeekly")


def sanitize_agy_metric(value: Any) -> dict[str, Any] | None:
    if not isinstance(value, dict):
        return None
    remaining = number(value.get("remainingPercent"))
    if remaining is None:
        return None
    metric: dict[str, Any] = {"remainingPercent": round(max(0.0, min(100.0, remaining)), 2)}
    reset = clean_reset(value.get("resetAt"))
    if reset is not None:
        metric["resetAt"] = reset
    return metric


def sanitize_agy_record(value: Any) -> dict[str, Any] | None:
    """Rebuild a fallback record from whitelisted fields only.

    Drops email, account, conversation/session identifiers, workspace, cwd,
    transcript paths, model content, and every unknown field. Returns None
    when no usable whitelisted metric survives.
    """
    if not isinstance(value, dict):
        return None
    metrics = value.get("metrics")
    if not isinstance(metrics, dict):
        return None
    clean: dict[str, Any] = {}
    for key in AGY_FALLBACK_METRIC_KEYS:
        metric = sanitize_agy_metric(metrics.get(key))
        if metric is not None:
            clean[key] = metric
    if not clean:
        return None
    record: dict[str, Any] = {"status": "ready", "source": "statusline", "metrics": clean}
    last_success = value.get("lastSuccessAt")
    if isinstance(last_success, str) and last_success and len(last_success) <= 64:
        record["lastSuccessAt"] = last_success
    return record


def load_agy_statusline() -> dict[str, Any] | None:
    if agy_cache_state() != "fresh":
        return None
    try:
        with AGY_STATUS_FILE.open("r", encoding="utf-8") as handle:
            value = json.load(handle)
    except (OSError, ValueError, TypeError):
        return None
    return sanitize_agy_record(value)


def has_metric(record: Any) -> bool:
    if not isinstance(record, dict):
        return False
    metrics = record.get("metrics")
    return isinstance(metrics, dict) and any(isinstance(value, dict) for value in metrics.values())


def merge_stale(previous: Any, current: dict[str, Any]) -> dict[str, Any]:
    if not has_metric(previous):
        return current
    merged = {"status": "stale", "source": current.get("source", "unknown"), "metrics": previous.get("metrics", {})}
    if isinstance(previous.get("lastSuccessAt"), str):
        merged["lastSuccessAt"] = previous["lastSuccessAt"]
    return merged


def fetch_once(timeout: float = REQUEST_TIMEOUT) -> Any:
    """Single CodexBar loopback request. May raise transport or parse errors."""
    request = urllib.request.Request(SERVER_URL, headers={"Accept": "application/json"})
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    with opener.open(request, timeout=timeout) as response:
        return json.load(response)


def fetch_snapshot_result() -> tuple[Any | None, str | None]:
    """Fetch with one short bounded retry inside a monotonic total budget.

    At most 2 attempts; each attempt's timeout is bounded by the remaining
    budget and no retry happens once the budget is exhausted, so the worst
    case is FETCH_BUDGET_SECONDS plus one bounded delay epsilon regardless
    of REQUEST_TIMEOUT. Returns (payload, error_class). error_class is None
    when the response is a valid JSON list; otherwise one of transport_error
    / invalid_json. An HTTP 200 with an empty or invalid body surfaces as
    invalid_json. No response body is ever logged or persisted.
    """
    deadline = time.monotonic() + FETCH_BUDGET_SECONDS
    error: str | None = None
    for attempt in range(FETCH_ATTEMPTS):
        remaining = deadline - time.monotonic()
        if remaining < MIN_REQUEST_TIMEOUT:
            break
        try:
            payload = fetch_once(timeout=min(REQUEST_TIMEOUT, remaining))
        except (urllib.error.URLError, OSError):
            # HTTPError subclasses URLError; both are transport failures.
            error = "transport_error"
        except (ValueError, TypeError):
            # Empty body and invalid JSON both fail JSON decoding here.
            error = "invalid_json"
        else:
            if isinstance(payload, list):
                return payload, None
            error = "invalid_json"
        if attempt < FETCH_ATTEMPTS - 1:
            delay = min(RETRY_DELAY_SECONDS, max(0.0, deadline - time.monotonic()))
            if delay <= 0:
                break
            time.sleep(delay)
    return None, error


def write_cache(snapshot: dict[str, Any]) -> None:
    CACHE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(CACHE_DIR, 0o700)
    descriptor, temporary = tempfile.mkstemp(prefix="status.", suffix=".tmp", dir=CACHE_DIR)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(snapshot, handle, ensure_ascii=False, separators=(",", ":"), sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, CACHE_FILE)
        os.chmod(CACHE_FILE, 0o600)
    except Exception:
        try:
            os.close(descriptor)
        except OSError:
            pass
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def write_agy_statusline(record: dict[str, Any]) -> None:
    CACHE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(CACHE_DIR, 0o700)
    descriptor, temporary = tempfile.mkstemp(prefix="antigravity-statusline.", suffix=".tmp", dir=CACHE_DIR)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(record, handle, ensure_ascii=False, separators=(",", ":"), sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, AGY_STATUS_FILE)
        os.chmod(AGY_STATUS_FILE, 0o600)
    except Exception:
        try:
            os.close(descriptor)
        except OSError:
            pass
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


HEALTH_KEYS = (
    "schema_version",
    "last_collector_run",
    "last_success",
    "antigravity_source",
    "antigravity_status",
    "statusline_cache_state",
    "codexbar_state",
    "last_error_class",
    "runtime_version",
)


def load_health() -> dict[str, Any]:
    try:
        with HEALTH_FILE.open("r", encoding="utf-8") as handle:
            value = json.load(handle)
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError, TypeError):
        return {}


def write_health(record: dict[str, Any]) -> None:
    """Persist only the whitelisted operational health keys, atomically with 0600."""
    sanitized = {key: record[key] for key in HEALTH_KEYS if key in record}
    if sanitized.get("last_error_class") not in (None, *ALLOWED_ERROR_CLASSES):
        sanitized["last_error_class"] = None
    CACHE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(CACHE_DIR, 0o700)
    descriptor, temporary = tempfile.mkstemp(prefix="health.", suffix=".tmp", dir=CACHE_DIR)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(sanitized, handle, ensure_ascii=False, separators=(",", ":"), sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, HEALTH_FILE)
        os.chmod(HEALTH_FILE, 0o600)
    except Exception:
        try:
            os.close(descriptor)
        except OSError:
            pass
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def collect() -> int:
    CACHE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(CACHE_DIR, 0o700)
    with LOCK_FILE.open("a+", encoding="utf-8") as lock:
        os.chmod(LOCK_FILE, 0o600)
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        previous = load_cache()
        payload, codex_error = fetch_snapshot_result()
        codexbar_state = "ok" if codex_error is None else codex_error
        agy_state = agy_cache_state()
        raw_antigravity = find_raw(payload, "antigravity")
        antigravity_offline = (
            isinstance(raw_antigravity, dict) and clean_source(raw_antigravity.get("source")) == "offline"
        )
        providers: dict[str, Any] = {}
        for provider in PROVIDER_IDS:
            current = provider_record(provider, find_raw(payload, provider))
            if provider == "antigravity" and clean_source(current.get("source")) == "offline":
                # AGY-FB-01 invariant: source == "offline" must never produce
                # current READY quota, even when the offline record still
                # carries metric values. Demote first; the fresh statusLine
                # fallback below is the only path back to READY.
                current = {"status": "unavailable", "source": "offline"}
            if provider == "antigravity" and current.get("status") != "ready":
                # A fresh valid statusLine fallback survives any CodexBar
                # failure mode; it is never erased by a broken upstream.
                current = load_agy_statusline() or current
            providers[provider] = current if current.get("status") == "ready" else merge_stale(previous.get("providers", {}).get(provider), current)
        snapshot = {
            "version": 1,
            "runtimeVersion": RUNTIME_VERSION,
            "snapshotAt": utc_now(),
            "server": {"host": "127.0.0.1", "port": 8097, "refreshIntervalSeconds": 120, "requestTimeoutSeconds": REQUEST_TIMEOUT},
            "providers": providers,
        }
        write_cache(snapshot)
        antigravity = providers.get("antigravity", {})
        if codex_error is not None:
            last_error: str | None = codex_error
        elif antigravity_offline:
            last_error = "provider_offline"
        elif isinstance(antigravity, dict) and antigravity.get("status") == "ready":
            last_error = None
        elif agy_state == "fresh":
            # Fresh fallback existed but could not produce READY; no invented class.
            last_error = None
        else:
            last_error = f"statusline_{agy_state}"
        if last_error is not None and last_error not in ALLOWED_ERROR_CLASSES:
            last_error = None
        run_at = utc_now()
        previous_health = load_health()
        # AGY-FB-01-R1: last_success advances only on a genuinely healthy
        # upstream cycle. A degraded cycle (offline provider, transport or
        # parse failure, or any fallback condition) must not move it, even
        # when a fresh statusLine fallback keeps Antigravity READY.
        healthy_upstream = codex_error is None and not antigravity_offline
        write_health({
            "schema_version": HEALTH_SCHEMA_VERSION,
            "last_collector_run": run_at,
            "last_success": run_at if healthy_upstream else previous_health.get("last_success"),
            "antigravity_source": antigravity.get("source", "unknown") if isinstance(antigravity, dict) else "unknown",
            "antigravity_status": antigravity.get("status", "unavailable") if isinstance(antigravity, dict) else "unavailable",
            "statusline_cache_state": agy_state,
            "codexbar_state": codexbar_state,
            "last_error_class": last_error,
            "runtime_version": RUNTIME_VERSION,
        })
        return 0


def percent_text(metric: Any) -> str:
    if not isinstance(metric, dict):
        return "--"
    value = number(metric.get("remainingPercent"))
    if value is None:
        return "--"
    if abs(value - round(value)) < 0.01:
        return str(int(round(value)))
    return f"{value:.1f}"


def status_record(root: dict[str, Any], provider: str, *metric_names: str) -> tuple[str, str, Any]:
    record = root.get("providers", {}).get(provider, {})
    if not isinstance(record, dict):
        return "--", "unavailable", None
    metrics = record.get("metrics")
    metric = None
    if isinstance(metrics, dict):
        metric = next((metrics.get(name) for name in metric_names if isinstance(metrics.get(name), dict)), None)
    return percent_text(metric), str(record.get("status", "unavailable")), metric


def render(root: dict[str, Any], mode: str) -> str:
    ag, ag_status, _ = status_record(root, "antigravity", "geminiFiveHour", "geminiWeekly")
    cc, cc_status, _ = status_record(root, "antigravity", "claudeGptFiveHour", "claudeGptWeekly")
    codex, codex_status, _ = status_record(root, "codex", "fiveHour")
    ali, ali_status, _ = status_record(root, "alibabatokenplan", "sevenDay")
    values = [("AG", ag, ag_status), ("CC" if mode == "cmux" else "CG", cc, cc_status), ("C", codex, codex_status)]
    if mode == "cmux":
        values.append(("ALI", ali, ali_status))
    parts = [f"{label} {value}" for label, value, _ in values]
    states = {state for _, _, state in values}
    if "unavailable" in states:
        parts.append("UNAVAILABLE")
    if "stale" in states:
        parts.append("STALE")
    return " · ".join(parts)


def self_test() -> int:
    if not CACHE_DIR.exists():
        print("cache directory: absent")
        return 1
    directory_mode = CACHE_DIR.stat().st_mode & 0o777
    print(f"cache directory mode: {directory_mode:04o}")
    if directory_mode != 0o700:
        return 1
    if not CACHE_FILE.exists():
        print("status file: absent")
        return 1
    file_mode = CACHE_FILE.stat().st_mode & 0o777
    print(f"status file mode: {file_mode:04o}")
    if file_mode != 0o600:
        return 1
    root = load_cache()
    if root.get("version") != 1 or set(root.get("providers", {})) != set(PROVIDER_IDS):
        print("status schema: invalid")
        return 1
    print("status schema: valid")
    return 0


def main() -> int:
    os.umask(0o077)
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("--tmux", action="store_true")
    parser.add_argument("--cmux", action="store_true")
    parser.add_argument("--self-test", action="store_true")
    parser.add_argument("--status", action="store_true")
    parser.add_argument("--agy-statusline", action="store_true")
    args = parser.parse_args()
    if args.agy_statusline:
        try:
            record = agy_statusline_record(json.load(sys.stdin))
            if record is not None:
                write_agy_statusline(record)
        except (OSError, ValueError, TypeError):
            pass
        print("")
        return 0
    if args.self_test:
        return self_test()
    if args.tmux or args.cmux or args.status:
        root = load_cache()
        if args.status:
            print(json.dumps({"snapshotAt": root.get("snapshotAt"), "runtimeVersion": root.get("runtimeVersion"), "providers": {key: {"status": value.get("status"), "source": value.get("source"), "metricKeys": sorted((value.get("metrics") or {}).keys())} for key, value in (root.get("providers") or {}).items() if isinstance(value, dict)}}, ensure_ascii=False, sort_keys=True))
            return 0
        print(render(root, "cmux" if args.cmux else "tmux"))
        return 0
    return collect()


if __name__ == "__main__":
    raise SystemExit(main())
