<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.ai-status-hub.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>__CODEXBAR_PATH__</string>
    <string>serve</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8097</string>
    <string>--refresh-interval</string>
    <string>120</string>
    <string>--request-timeout</string>
    <string>30</string>
    <string>--log-level</string>
    <string>warning</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>WorkingDirectory</key>
  <string>__HOME__</string>
</dict>
</plist>
